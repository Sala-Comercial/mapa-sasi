# Copie este arquivo para ".env" (o Iniciar_Mapa.bat já faz isso) e preencha o token do HubSpot.
# O token é uma senha: não envie por chat nem por e-mail, e não deixe este arquivo em pasta compartilhada.

# Token do aplicativo privado do HubSpot (começa com "pat-"). Veja o LEIA-ME.
HUBSPOT_TOKEN=

# Porta do site. Endereço: http://localhost:8800
PORT=8800

# Para outras pessoas da rede abrirem o site, troque por 0.0.0.0 (e proteja com usuário e senha abaixo).
HOST=127.0.0.1

# De quantos em quantos segundos o servidor procura negócios novos ou alterados no HubSpot.
SYNC_SEGUNDOS=60

# Proteção opcional do site por usuário e senha (deixe vazio para não pedir).
MAPA_USUARIO=
MAPA_SENHA=

# Tempo real pelo webhook do HubSpot (opcional; precisa de endereço público do site).
# PUBLIC_URL=https://mapa.suaempresa.com.br
# HUBSPOT_CLIENT_SECRET=
